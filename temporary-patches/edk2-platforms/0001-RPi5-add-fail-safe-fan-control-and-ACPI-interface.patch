index 0000000000000000000000000000000000000000..9918292bc64d938eb4ef77c890bf8e3d6f095f22
--- /dev/null
+++ b/Silicon/RaspberryPi/RpiSiliconPkg/Drivers/Rp1BusDxe/Rp1Fan.c
@@ -0,0 +1,197 @@
+/** @file
+ *  RP1 PWM1 channel 3 control for the Raspberry Pi 5 cooling-fan header.
+ *
+ *  GPIO45 is routed to PWM1 channel 3 at approximately 24 kHz with inverted
+ *  polarity, matching the official Raspberry Pi 5 Active Cooler interface.
+ *
+ *  SPDX-License-Identifier: BSD-2-Clause-Patent
+ */
+
+#include <Uefi.h>
+#include <Library/DebugLib.h>
+#include <Library/IoLib.h>
+#include <Rp1.h>
+
+#include "Rp1BusDxe.h"
+#include "Rp1Fan.h"
+
+#define RP1_FAN_GPIO_BANK_BASE           RP1_IO_BANK2_BASE
+#define RP1_FAN_GPIO_BANK_PIN            11
+#define RP1_FAN_GPIO_CTRL_OFFSET         0x004
+#define RP1_FAN_GPIO_CTRL_FUNCSEL_MASK   0x01F
+#define RP1_FAN_GPIO_CTRL_OUTOVER_MASK   0x3000
+#define RP1_FAN_GPIO_CTRL_OEOVER_MASK    0xC000
+
+#define RP1_FAN_PAD_BANK_BASE            RP1_PADS_BANK2_BASE
+#define RP1_FAN_PAD_BANK_OFFSET          0x004
+#define RP1_FAN_PAD_OUT_DISABLE          BIT7
+#define RP1_FAN_PAD_INPUT_ENABLE         BIT6
+#define RP1_FAN_PAD_PULL_MASK            (BIT3 | BIT2)
+#define RP1_FAN_PAD_PULL_DOWN            BIT2
+
+#define RP1_CLOCK_PWM1_CTRL_OFFSET       0x084
+#define RP1_CLOCK_PWM1_DIV_INT_OFFSET    0x088
+#define RP1_CLOCK_PWM1_DIV_FRAC_OFFSET   0x08C
+#define RP1_CLOCK_PWM1_SEL_OFFSET        0x090
+#define RP1_CLOCK_CTRL_ENABLE            BIT11
+#define RP1_CLOCK_CTRL_AUXSRC_MASK       0x3E0
+#define RP1_CLOCK_CTRL_SRC_MASK          BIT0
+#define RP1_CLOCK_CTRL_AUXSRC_XOSC       (2U << 5)
+#define RP1_CLOCK_CTRL_SRC_AUX           BIT0
+#define RP1_CLOCK_PWM1_DIV_INT_50MHZ     1
+#define RP1_CLOCK_PWM1_SEL_50MHZ         BIT1
+
+#define RP1_PWM_GLOBAL_CTRL_OFFSET       0x000
+#define RP1_PWM_CHANNEL_CTRL_OFFSET(I)   (0x014 + ((I) * 0x10))
+#define RP1_PWM_RANGE_OFFSET(I)          (0x018 + ((I) * 0x10))
+#define RP1_PWM_DUTY_OFFSET(I)           (0x020 + ((I) * 0x10))
+#define RP1_PWM_CHANNEL                  3
+#define RP1_PWM_CHANNEL_DEFAULT          (BIT8 | BIT0)
+#define RP1_PWM_POLARITY_INVERTED        BIT3
+#define RP1_PWM_GLOBAL_CHANNEL_ENABLE(I) (1U << (I))
+#define RP1_PWM_GLOBAL_SET_UPDATE        BIT31
+#define RP1_FAN_PWM_RANGE                2078
+#define RP1_FAN_PWM_DUTY_MAX             2038
+
+typedef struct {
+  BOOLEAN  Valid;
+  UINT32   ClockCtrl;
+  UINT32   ClockDivInt;
+  UINT32   ClockDivFrac;
+  UINT32   ClockSel;
+  UINT32   GpioCtrl;
+  UINT32   PadCtrl;
+  UINT32   PwmGlobalCtrl;
+  UINT32   PwmChannelCtrl;
+  UINT32   PwmRange;
+  UINT32   PwmDuty;
+} RP1_FAN_SAVED_STATE;
+
+STATIC RP1_FAN_SAVED_STATE  mFanSavedState;
+
+EFI_STATUS
+EFIAPI
+Rp1BusSetFanSpeed (
+  IN RP1_BUS_PROTOCOL  *This,
+  IN UINT8             Percent
+  )
+{
+  RP1_BUS_DATA          *Rp1Data;
+  EFI_PHYSICAL_ADDRESS  ClockBase;
+  EFI_PHYSICAL_ADDRESS  GpioCtrl;
+  EFI_PHYSICAL_ADDRESS  PadCtrl;
+  EFI_PHYSICAL_ADDRESS  PwmBase;
+  UINT32                Value;
+
+  if ((This == NULL) || (Percent > 100)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  Rp1Data   = RP1_BUS_DATA_FROM_THIS (This);
+  ClockBase = Rp1Data->PeripheralBase + RP1_CLOCKS_MAIN_BASE;
+  PwmBase   = Rp1Data->PeripheralBase + RP1_PWM1_BASE;
+  GpioCtrl  = Rp1Data->PeripheralBase + RP1_FAN_GPIO_BANK_BASE +
+              (RP1_FAN_GPIO_BANK_PIN * 8) + RP1_FAN_GPIO_CTRL_OFFSET;
+  PadCtrl   = Rp1Data->PeripheralBase + RP1_FAN_PAD_BANK_BASE +
+              RP1_FAN_PAD_BANK_OFFSET + (RP1_FAN_GPIO_BANK_PIN * 4);
+
+  if (!mFanSavedState.Valid) {
+    mFanSavedState.ClockCtrl      = MmioRead32 (ClockBase + RP1_CLOCK_PWM1_CTRL_OFFSET);
+    mFanSavedState.ClockDivInt    = MmioRead32 (ClockBase + RP1_CLOCK_PWM1_DIV_INT_OFFSET);
+    mFanSavedState.ClockDivFrac   = MmioRead32 (ClockBase + RP1_CLOCK_PWM1_DIV_FRAC_OFFSET);
+    mFanSavedState.ClockSel       = MmioRead32 (ClockBase + RP1_CLOCK_PWM1_SEL_OFFSET);
+    mFanSavedState.GpioCtrl       = MmioRead32 (GpioCtrl);
+    mFanSavedState.PadCtrl        = MmioRead32 (PadCtrl);
+    mFanSavedState.PwmGlobalCtrl  = MmioRead32 (PwmBase + RP1_PWM_GLOBAL_CTRL_OFFSET);
+    mFanSavedState.PwmChannelCtrl = MmioRead32 (PwmBase + RP1_PWM_CHANNEL_CTRL_OFFSET (RP1_PWM_CHANNEL));
+    mFanSavedState.PwmRange       = MmioRead32 (PwmBase + RP1_PWM_RANGE_OFFSET (RP1_PWM_CHANNEL));
+    mFanSavedState.PwmDuty        = MmioRead32 (PwmBase + RP1_PWM_DUTY_OFFSET (RP1_PWM_CHANNEL));
+    mFanSavedState.Valid          = TRUE;
+  }
+
+  Value  = MmioRead32 (ClockBase + RP1_CLOCK_PWM1_CTRL_OFFSET);
+  Value &= ~RP1_CLOCK_CTRL_ENABLE;
+  MmioWrite32 (ClockBase + RP1_CLOCK_PWM1_CTRL_OFFSET, Value);
+  MmioWrite32 (ClockBase + RP1_CLOCK_PWM1_DIV_INT_OFFSET, RP1_CLOCK_PWM1_DIV_INT_50MHZ);
+  MmioWrite32 (ClockBase + RP1_CLOCK_PWM1_DIV_FRAC_OFFSET, 0);
+  MmioWrite32 (ClockBase + RP1_CLOCK_PWM1_SEL_OFFSET, RP1_CLOCK_PWM1_SEL_50MHZ);
+  Value  = MmioRead32 (ClockBase + RP1_CLOCK_PWM1_CTRL_OFFSET);
+  Value &= ~(RP1_CLOCK_CTRL_AUXSRC_MASK | RP1_CLOCK_CTRL_SRC_MASK);
+  Value |= RP1_CLOCK_CTRL_AUXSRC_XOSC | RP1_CLOCK_CTRL_SRC_AUX |
+           RP1_CLOCK_CTRL_ENABLE;
+  MmioWrite32 (ClockBase + RP1_CLOCK_PWM1_CTRL_OFFSET, Value);
+
+  Value  = MmioRead32 (PadCtrl);
+  Value &= ~(RP1_FAN_PAD_OUT_DISABLE | RP1_FAN_PAD_PULL_MASK);
+  Value |= RP1_FAN_PAD_INPUT_ENABLE | RP1_FAN_PAD_PULL_DOWN;
+  MmioWrite32 (PadCtrl, Value);
+
+  // GPIO45 function zero is PWM1 channel 3 on RP1.
+  Value  = MmioRead32 (GpioCtrl);
+  Value &= ~(RP1_FAN_GPIO_CTRL_FUNCSEL_MASK |
+             RP1_FAN_GPIO_CTRL_OUTOVER_MASK |
+             RP1_FAN_GPIO_CTRL_OEOVER_MASK);
+  MmioWrite32 (GpioCtrl, Value);
+
+  MmioWrite32 (
+    PwmBase + RP1_PWM_CHANNEL_CTRL_OFFSET (RP1_PWM_CHANNEL),
+    RP1_PWM_CHANNEL_DEFAULT | RP1_PWM_POLARITY_INVERTED
+    );
+  MmioWrite32 (
+    PwmBase + RP1_PWM_RANGE_OFFSET (RP1_PWM_CHANNEL),
+    RP1_FAN_PWM_RANGE
+    );
+  MmioWrite32 (
+    PwmBase + RP1_PWM_DUTY_OFFSET (RP1_PWM_CHANNEL),
+    (RP1_FAN_PWM_DUTY_MAX * Percent + 50) / 100
+    );
+
+  Value  = MmioRead32 (PwmBase + RP1_PWM_GLOBAL_CTRL_OFFSET);
+  Value |= RP1_PWM_GLOBAL_CHANNEL_ENABLE (RP1_PWM_CHANNEL);
+  MmioWrite32 (PwmBase + RP1_PWM_GLOBAL_CTRL_OFFSET, Value);
+  MmioWrite32 (
+    PwmBase + RP1_PWM_GLOBAL_CTRL_OFFSET,
+    Value | RP1_PWM_GLOBAL_SET_UPDATE
+    );
+
+  DEBUG ((DEBUG_INFO, "RP1: cooling fan set to %u%%\n", Percent));
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS
+EFIAPI
+Rp1BusRestoreFanState (
+  IN RP1_BUS_PROTOCOL  *This
+  )
+{
+  RP1_BUS_DATA          *Rp1Data;
+  EFI_PHYSICAL_ADDRESS  ClockBase;
+  EFI_PHYSICAL_ADDRESS  GpioCtrl;
+  EFI_PHYSICAL_ADDRESS  PadCtrl;
+  EFI_PHYSICAL_ADDRESS  PwmBase;
+
+  if ((This == NULL) || !mFanSavedState.Valid) {
+    return EFI_NOT_READY;
+  }
+
+  Rp1Data   = RP1_BUS_DATA_FROM_THIS (This);
+  ClockBase = Rp1Data->PeripheralBase + RP1_CLOCKS_MAIN_BASE;
+  PwmBase   = Rp1Data->PeripheralBase + RP1_PWM1_BASE;
+  GpioCtrl  = Rp1Data->PeripheralBase + RP1_FAN_GPIO_BANK_BASE +
+              (RP1_FAN_GPIO_BANK_PIN * 8) + RP1_FAN_GPIO_CTRL_OFFSET;
+  PadCtrl   = Rp1Data->PeripheralBase + RP1_FAN_PAD_BANK_BASE +
+              RP1_FAN_PAD_BANK_OFFSET + (RP1_FAN_GPIO_BANK_PIN * 4);
+
+  MmioWrite32 (PwmBase + RP1_PWM_GLOBAL_CTRL_OFFSET, mFanSavedState.PwmGlobalCtrl);
+  MmioWrite32 (PwmBase + RP1_PWM_CHANNEL_CTRL_OFFSET (RP1_PWM_CHANNEL), mFanSavedState.PwmChannelCtrl);
+  MmioWrite32 (PwmBase + RP1_PWM_RANGE_OFFSET (RP1_PWM_CHANNEL), mFanSavedState.PwmRange);
+  MmioWrite32 (PwmBase + RP1_PWM_DUTY_OFFSET (RP1_PWM_CHANNEL), mFanSavedState.PwmDuty);
+  MmioWrite32 (GpioCtrl, mFanSavedState.GpioCtrl);
+  MmioWrite32 (PadCtrl, mFanSavedState.PadCtrl);
+  MmioWrite32 (ClockBase + RP1_CLOCK_PWM1_DIV_INT_OFFSET, mFanSavedState.ClockDivInt);
+  MmioWrite32 (ClockBase + RP1_CLOCK_PWM1_DIV_FRAC_OFFSET, mFanSavedState.ClockDivFrac);
+  MmioWrite32 (ClockBase + RP1_CLOCK_PWM1_SEL_OFFSET, mFanSavedState.ClockSel);
+  MmioWrite32 (ClockBase + RP1_CLOCK_PWM1_CTRL_OFFSET, mFanSavedState.ClockCtrl);
+  mFanSavedState.Valid = FALSE;
+  return EFI_SUCCESS;
+}

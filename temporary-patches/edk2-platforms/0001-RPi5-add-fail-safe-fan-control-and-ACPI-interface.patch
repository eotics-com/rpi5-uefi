+
+//
+// Raspberry Pi 5 cooling-fan interface for the experimental Windows ARM64
+// driver. Resource order is an ABI: clocks, PWM1, GPIO bank 2, pad bank 2,
+// then the BCM2712 property mailbox.
+//
+Device (FAN0) {
+  Name (_HID, "RPI0FAN")
+  Name (_UID, 0x0)
+  Name (_CCA, 0x0)
+
+  Method (_CRS, 0, Serialized) {
+    Name (RBUF, ResourceTemplate () {
+      RP1_QWORDMEMORY_BUF (00)
+      RP1_QWORDMEMORY_BUF (01)
+      RP1_QWORDMEMORY_BUF (02)
+      RP1_QWORDMEMORY_BUF (03)
+      QWordMemory (ResourceConsumer,
+        PosDecode,
+        MinFixed,
+        MaxFixed,
+        NonCacheable,
+        ReadWrite,
+        0x0,
+        0x000000107C013880,
+        0x000000107C0138BF,
+        0x0,
+        0x40,
+        ,
+        ,
+        )
+    })
+    RP1_QWORDMEMORY_SET (00, RP1_CLOCKS_MAIN_BASE, 0x1000)
+    RP1_QWORDMEMORY_SET (01, RP1_PWM1_BASE, 0x1000)
+    RP1_QWORDMEMORY_SET (02, RP1_IO_BANK2_BASE, 0x1000)
+    RP1_QWORDMEMORY_SET (03, RP1_PADS_BANK2_BASE, 0x1000)
+    Return (RBUF)
+  }
+
+  Name (_DSD, Package () {
+    ToUUID ("daffd814-6eba-4d8c-8a91-bc9bbf4aa301"),
+    Package () {
+      Package () { "compatible", "raspberrypi,rpi5-fan" },
+      Package () { "clock-frequency", 50000000 },
+      Package () { "pwm-frequency", 24000 },
+      Package () { "pwm-channel", 3 },
+      Package () { "fan-gpio", 45 },
+      Package () { "failsafe-percent", 100 }
+    }
+  })
+}

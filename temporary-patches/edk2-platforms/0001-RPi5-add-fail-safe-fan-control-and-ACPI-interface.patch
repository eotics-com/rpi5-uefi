diff --git a/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/FanControl.c b/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/FanControl.c
new file mode 100644
index 0000000000000000000000000000000000000000..d3ababb6aa45df66fbbe764eb088377d925b6bdd
--- /dev/null
+++ b/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/FanControl.c
@@ -0,0 +1,351 @@
+/** @file
+ *  Raspberry Pi 5 RP1 PWM cooling-fan control.
+ *
+ *  Automatic control exists only while UEFI Boot Services are active.
+ *  Persistent mode intentionally leaves the selected PWM state programmed
+ *  for an operating system that does not yet own the fan controller.
+ *
+ *  SPDX-License-Identifier: BSD-2-Clause-Patent
+ */
+
+#include <Uefi.h>
+#include <Guid/EventGroup.h>
+#include <Guid/RpiPlatformFormSetGuid.h>
+#include <Library/DebugLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+#include <Protocol/Rp1Bus.h>
+#include <Protocol/RpiFirmware.h>
+#include <RpiPlatformVarStoreData.h>
+
+#include "FanControl.h"
+
+#define FAN_UPDATE_PERIOD_100NS  (2ULL * 1000 * 1000 * 10)
+#define FAN_FAIL_SAFE_SPEED      100
+#define FAN_MINIMUM_SPEED        30
+
+STATIC FAN_MODE_VARSTORE_DATA          mFanMode  = { FAN_MODE_PERSISTENT };
+STATIC FAN_SPEED_VARSTORE_DATA         mFanSpeed = { FAN_FAIL_SAFE_SPEED };
+STATIC RP1_BUS_PROTOCOL                *mRp1Bus;
+STATIC RASPBERRY_PI_FIRMWARE_PROTOCOL  *mFirmware;
+STATIC EFI_EVENT                       mFanTimer;
+STATIC EFI_EVENT                       mRp1NotifyEvent;
+STATIC EFI_EVENT                       mFirmwareNotifyEvent;
+STATIC EFI_EVENT                       mExitBootServicesEvent;
+STATIC VOID                            *mRp1Registration;
+STATIC VOID                            *mFirmwareRegistration;
+STATIC UINT8                           mAutomaticSpeed = FAN_FAIL_SAFE_SPEED;
+STATIC BOOLEAN                         mForcePersistentFailSafe;
+
+STATIC
+UINT8
+GetAutomaticFanSpeed (
+  IN UINT32  MilliCelsius
+  )
+{
+  UINT8  Target;
+
+  // User-selected curve with 5 C hysteresis on downward transitions.
+  if (MilliCelsius >= 75000) {
+    Target = 100;
+  } else if (MilliCelsius >= 67500) {
+    Target = 70;
+  } else if (MilliCelsius >= 60000) {
+    Target = 50;
+  } else if (MilliCelsius >= 50000) {
+    Target = 40;
+  } else {
+    Target = 30;
+  }
+
+  if (Target < mAutomaticSpeed) {
+    if ((mAutomaticSpeed == 100) && (MilliCelsius >= 70000)) {
+      return 100;
+    }
+
+    if ((mAutomaticSpeed == 70) && (MilliCelsius >= 62500)) {
+      return 70;
+    }
+
+    if ((mAutomaticSpeed == 50) && (MilliCelsius >= 55000)) {
+      return 50;
+    }
+
+    if ((mAutomaticSpeed == 40) && (MilliCelsius >= 45000)) {
+      return 40;
+    }
+  }
+
+  return Target;
+}
+
+STATIC
+VOID
+EFIAPI
+UpdateFan (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  EFI_STATUS  Status;
+  UINT32      Temperature;
+  UINT8       Speed;
+  UINTN       Size;
+
+  (VOID)Event;
+  (VOID)Context;
+
+  if (mRp1Bus == NULL) {
+    return;
+  }
+
+  if (mFirmware == NULL) {
+    gBS->LocateProtocol (
+           &gRaspberryPiFirmwareProtocolGuid,
+           NULL,
+           (VOID **)&mFirmware
+           );
+  }
+
+  Size = sizeof (mFanMode);
+  Status = gRT->GetVariable (
+                  L"FanMode",
+                  &gRpiPlatformFormSetGuid,
+                  NULL,
+                  &Size,
+                  &mFanMode
+                  );
+  if (EFI_ERROR (Status) || (mFanMode.Value > FAN_MODE_PERSISTENT)) {
+    mFanMode.Value = FAN_MODE_PERSISTENT;
+  }
+
+  Size = sizeof (mFanSpeed);
+  Status = gRT->GetVariable (
+                  L"FanSpeed",
+                  &gRpiPlatformFormSetGuid,
+                  NULL,
+                  &Size,
+                  &mFanSpeed
+                  );
+  if (EFI_ERROR (Status) || (mFanSpeed.Value < FAN_MINIMUM_SPEED) ||
+      (mFanSpeed.Value > FAN_FAIL_SAFE_SPEED))
+  {
+    mFanSpeed.Value = FAN_FAIL_SAFE_SPEED;
+  }
+
+  if (mForcePersistentFailSafe) {
+    mFanMode.Value = FAN_MODE_PERSISTENT;
+    Speed          = FAN_FAIL_SAFE_SPEED;
+  } else if ((mFanMode.Value == FAN_MODE_MANUAL) ||
+      (mFanMode.Value == FAN_MODE_PERSISTENT))
+  {
+    Speed = mFanSpeed.Value;
+  } else {
+    if (mFirmware == NULL) {
+      Speed = FAN_FAIL_SAFE_SPEED;
+    } else {
+      Status = mFirmware->GetTemperature (&Temperature);
+      if (EFI_ERROR (Status)) {
+        Speed = FAN_FAIL_SAFE_SPEED;
+      } else {
+        Speed           = GetAutomaticFanSpeed (Temperature);
+        mAutomaticSpeed = Speed;
+      }
+    }
+  }
+
+  Status = mRp1Bus->SetFanSpeed (mRp1Bus, Speed);
+  if (EFI_ERROR (Status) && (Speed != FAN_FAIL_SAFE_SPEED)) {
+    mRp1Bus->SetFanSpeed (mRp1Bus, FAN_FAIL_SAFE_SPEED);
+  }
+}
+
+STATIC
+VOID
+TryStartFanControl (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+
+  if (mFanTimer != NULL) {
+    return;
+  }
+
+  Status = gBS->LocateProtocol (
+                  &gRp1BusProtocolGuid,
+                  NULL,
+                  (VOID **)&mRp1Bus
+                  );
+  if (EFI_ERROR (Status)) {
+    mRp1Bus = NULL;
+    return;
+  }
+
+  // Establish a safe fan state before starting periodic temperature checks.
+  Status = mRp1Bus->SetFanSpeed (mRp1Bus, FAN_FAIL_SAFE_SPEED);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "%a: failed to establish fan fail-safe: %r\n", __func__, Status));
+    return;
+  }
+
+  Status = gBS->LocateProtocol (
+                  &gRaspberryPiFirmwareProtocolGuid,
+                  NULL,
+                  (VOID **)&mFirmware
+                  );
+  if (EFI_ERROR (Status)) {
+    mFirmware = NULL;
+  }
+
+  UpdateFan (NULL, NULL);
+  Status = gBS->CreateEvent (
+                  EVT_TIMER | EVT_NOTIFY_SIGNAL,
+                  TPL_CALLBACK,
+                  UpdateFan,
+                  NULL,
+                  &mFanTimer
+                  );
+  if (EFI_ERROR (Status)) {
+    mRp1Bus->SetFanSpeed (mRp1Bus, FAN_FAIL_SAFE_SPEED);
+    mFanTimer = NULL;
+    return;
+  }
+
+  Status = gBS->SetTimer (mFanTimer, TimerPeriodic, FAN_UPDATE_PERIOD_100NS);
+  if (EFI_ERROR (Status)) {
+    mRp1Bus->SetFanSpeed (mRp1Bus, FAN_FAIL_SAFE_SPEED);
+    gBS->CloseEvent (mFanTimer);
+    mFanTimer = NULL;
+  }
+}
+
+STATIC
+VOID
+EFIAPI
+FanProtocolNotify (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  (VOID)Event;
+  (VOID)Context;
+  TryStartFanControl ();
+}
+
+STATIC
+VOID
+EFIAPI
+FanExitBootServices (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  (VOID)Event;
+  (VOID)Context;
+
+  // UEFI timers do not run after ExitBootServices. Persistent mode leaves the
+  // last PWM value active; all other modes restore the pre-UEFI RP1 state.
+  if ((mRp1Bus != NULL) && (mFanMode.Value != FAN_MODE_PERSISTENT)) {
+    mRp1Bus->RestoreFanState (mRp1Bus);
+  }
+}
+
+VOID
+SetupFanVariables (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  UINTN       Size;
+  UINT32      Attributes;
+
+  Attributes = EFI_VARIABLE_NON_VOLATILE |
+               EFI_VARIABLE_BOOTSERVICE_ACCESS |
+               EFI_VARIABLE_RUNTIME_ACCESS;
+
+  Size = sizeof (mFanMode);
+  Status = gRT->GetVariable (
+                  L"FanMode",
+                  &gRpiPlatformFormSetGuid,
+                  NULL,
+                  &Size,
+                  &mFanMode
+                  );
+  if (EFI_ERROR (Status) || (mFanMode.Value > FAN_MODE_PERSISTENT)) {
+    mFanMode.Value = FAN_MODE_PERSISTENT;
+    Status = gRT->SetVariable (
+                    L"FanMode",
+                    &gRpiPlatformFormSetGuid,
+                    Attributes,
+                    sizeof (mFanMode),
+                    &mFanMode
+                    );
+    if (EFI_ERROR (Status)) {
+      DEBUG ((DEBUG_WARN, "%a: could not persist FanMode: %r\n", __func__, Status));
+    }
+  }
+
+  Size = sizeof (mFanSpeed);
+  Status = gRT->GetVariable (
+                  L"FanSpeed",
+                  &gRpiPlatformFormSetGuid,
+                  NULL,
+                  &Size,
+                  &mFanSpeed
+                  );
+  if (EFI_ERROR (Status) || (mFanSpeed.Value < FAN_MINIMUM_SPEED) ||
+      (mFanSpeed.Value > FAN_FAIL_SAFE_SPEED))
+  {
+    mFanSpeed.Value = FAN_FAIL_SAFE_SPEED;
+    Status = gRT->SetVariable (
+                    L"FanSpeed",
+                    &gRpiPlatformFormSetGuid,
+                    Attributes,
+                    sizeof (mFanSpeed),
+                    &mFanSpeed
+                    );
+    if (EFI_ERROR (Status)) {
+      DEBUG ((DEBUG_WARN, "%a: could not persist FanSpeed: %r\n", __func__, Status));
+    }
+  }
+}
+
+VOID
+ApplyFanVariables (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+
+  Status = gBS->CreateEventEx (
+                  EVT_NOTIFY_SIGNAL,
+                  TPL_NOTIFY,
+                  FanExitBootServices,
+                  NULL,
+                  &gEfiEventExitBootServicesGuid,
+                  &mExitBootServicesEvent
+                  );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "%a: failed to register ExitBootServices event: %r\n", __func__, Status));
+    mForcePersistentFailSafe = TRUE;
+  }
+
+  mRp1NotifyEvent = EfiCreateProtocolNotifyEvent (
+                      &gRp1BusProtocolGuid,
+                      TPL_CALLBACK,
+                      FanProtocolNotify,
+                      NULL,
+                      &mRp1Registration
+                      );
+  mFirmwareNotifyEvent = EfiCreateProtocolNotifyEvent (
+                           &gRaspberryPiFirmwareProtocolGuid,
+                           TPL_CALLBACK,
+                           FanProtocolNotify,
+                           NULL,
+                           &mFirmwareRegistration
+                           );
+
+  TryStartFanControl ();
+}
